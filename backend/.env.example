OPENAI_API_KEY=
MODEL_NAME=gpt-5.4-nano
INTENT_MODEL_NAME=gpt-5.4-nano
EMBEDDING_MODEL=text-embedding-3-large
ENCRYPTION_KEY=
ADMIN_PASSWORD=admin1234

DATABASE_URL=sqlite:///./chatbot.db

AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PREFIX=document-chatbot
AWS_EC2_INSTANCE_ID=
AWS_BILLING_ENABLED=true
# Cost Explorer는 USD를 반환하므로 화면의 예상 원화 환산에 사용할 기준 환율입니다.
AWS_BILLING_USD_KRW_RATE=1430
# 관리 계정에서 특정 연결 계정만 수집할 경우 쉼표로 구분합니다. 비우면 조회 가능한 전체 계정입니다.
AWS_BILLING_ACCOUNT_IDS=
AWS_BILLING_ACCOUNT_NAME=

CHANNEL_TALK_URL=
WEBSITE_SYNC_ENABLED=true
WEBSITE_SYNC_INTERVAL_HOURS=24
WEBSITE_FETCH_TIMEOUT_SECONDS=30

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=document-chatbot
LANGSMITH_TRACING_V2=true
